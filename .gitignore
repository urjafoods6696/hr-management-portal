# ==============================================================================
# TalentPulse ATS / HR Management Portal - Comprehensive .gitignore
# ==============================================================================

# Dependencies & Package Managers
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Artifacts
**/target/
**/dist/
**/build/
.gradle/
*.jar
*.war
*.ear

# Tooling Binaries, Profiles & Scratch
/tools/
/temp_chrome_profile/
**/temp_chrome*
**/chrome-profile*
**/edge_temp*
**/temp_*
**/scratch/
chrome_*.png
**/.vite/

# Backups & Database Dumps
**/backups/
*.dump
*.dmp
*.sql.gz
*.sql.bak
*.sql.tar

# Local Environment Variables & Secrets
.env
.env.*
!.env.example
.env.local
.env.*.local

# Credentials & Keyrings
*.pem
*.key
*.pkcs12
*.p12
*.pfx
id_rsa
id_ed25519

# IDE & Editor Temporary Files
.vscode/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# Application Logs & Diagnostics
*.log
*.tmp
*.bak
*.crdownload
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-Generated Files
Thumbs.db
[Dd]esktop.ini
.DS_Store
*.swp
*.swo

# Uploaded Private User Documents & Media (Preserve Directory Structure via .gitkeep)
hr-management-portal/backend/uploads/**
!hr-management-portal/backend/uploads/
!hr-management-portal/backend/uploads/**/
!hr-management-portal/backend/uploads/**/.gitkeep
