# ==============================================================================
# TalentPulse ATS / HR Management Portal - Sub-project .gitignore
# ==============================================================================

# Dependencies & Build Outputs
**/node_modules/
target/
**/target/
dist/
**/dist/
build/
**/build/
.gradle/
*.jar
*.war
*.ear

# Tooling Binaries & Scratch
/tools/
/temp_chrome_profile/
**/temp_chrome*
**/chrome-profile*
**/edge_temp*
**/temp_*
**/scratch/
**/.vite/

# Backups & Database Dumps
backups/
**/backups/
*.dump
*.dmp
*.sql.gz
*.sql.bak
*.sql.tar

# Local Environments & Secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
application-local.yml
**/application-local.yml
**/application-local*.yml

# Credentials
*.pem
*.key
*.pkcs12
*.p12
*.pfx
id_rsa
id_ed25519

# IDE & Editor Temporary Files
.vscode/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# Logs & Diagnostics
logs/
**/logs/
*.log
*.tmp
*.bak
*.crdownload
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Uploads
uploads/
**/uploads/**
!**/uploads/
!**/uploads/**/
!**/uploads/**/.gitkeep
